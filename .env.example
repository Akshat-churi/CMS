# ContentPilot AI - Environment Configuration
# Copy this file to .env and fill in your Supabase & AI provider credentials

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (Optional for local testing; required for live Supabase deployment)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fallback JWT Secret
JWT_SECRET=contentpilot-super-secret-jwt-key-2026-phase1

# Phase 2: AI Integration (Optional LLM Provider Configuration)
# When set, enables AI Content Generator, Writing Assistant, SEO Assistant, Summarizer, and Content Reviewer.
# If left empty, ContentPilot CMS continues operating normally with manual editing.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
# Optional custom base URL for OpenAI-compatible proxies (e.g. Groq, OpenRouter, local Ollama)
AI_BASE_URL=
